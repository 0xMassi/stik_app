{
  "name": "stik",
  "version": "0.9.0",
  "description": "Instant thought capture. One shortcut, post-it appears, type, close.",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:platform": "node scripts/check-platform-consistency.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "version": "echo \"Stik v$(node -p \"require('./package.json').version\")\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@replit/codemirror-vim": "^6.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.0",
    "marked": "^17.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
